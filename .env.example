# ---------------------------------------------------------
# Django core
# ---------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key

# ---------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------
DB_NAME=stepupmark_learnhub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------
# CORS / CSRF / Hosts (comma separated, no spaces)
# ---------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------
# Email (SMTP) - used for OTP / verification / password reset emails
# ---------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=StepUpMark <noreply@example.com>
SERVER_EMAIL=noreply@example.com

# Optional - falls back to DEFAULT_FROM_EMAIL if not set
SUPPORT_EMAIL=support@example.com
